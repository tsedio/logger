{
  "name": "@tsed/logger-root",
  "version": "8.0.7",
  "private": true,
  "description": "A multi channel logger written in TypeScript.",
  "keywords": [
    "debug",
    "log",
    "trace",
    "ts",
    "typescript"
  ],
  "homepage": "https://github.com/tsedio/logger",
  "bugs": {
    "url": "https://github.com/tsedio/logger/issues"
  },
  "license": "MIT",
  "author": "Romain Lenzotti",
  "repository": {
    "type": "git",
    "url": "https://github.com/tsedio/logger.git"
  },
  "directories": {
    "test": "test",
    "packages": "packages"
  },
  "workspaces": {
    "packages": [
      "packages/*",
      "tools/*"
    ]
  },
  "type": "module",
  "scripts": {
    "postinstall": "cd docs && yarn install && cd ..",
    "clean": "monorepo clean workspace",
    "test": "yarn test:lint && yarn test:coverage",
    "test:unit": "vitest run",
    "test:ci": "vitest run --coverage --coverage.thresholds.autoUpdate=true",
    "test:coverage": "vitest run --coverage --coverage.thresholds.autoUpdate=true",
    "test:lint": "oxlint . && node ./tools/oxc/check-workspace-imports.mjs",
    "test:lint:fix": "oxlint --fix . && node ./tools/oxc/check-workspace-imports.mjs",
    "build": "monorepo build --verbose",
    "build:references": "node ./tools/typescript",
    "compile": "lerna run build",
    "sync:packages": "monorepo sync packages",
    "api:build": "rm -rf ./docs/api && tsc -b && tsdoc",
    "api:build:dev": "npx -p chokidar-cli chokidar \"docs/.templates/**/*.{js,ejs}\" -c \"tsdoc\"",
    "docs:install": "cd docs && yarn install && cd ..",
    "docs:build": "yarn api:build && yarn vitepress:build",
    "docs:serve": "yarn api:build && yarn vitepress:serve",
    "docs:publish": "CI=1 monorepo publish ghpages",
    "vitepress:build": "cd ./docs && yarn docs:build",
    "vitepress:serve": "yarn docs:install && cd docs && yarn docs:dev",
    "format": "oxfmt '**/*.{ts,tsx,js,jsx,mts,cts,mjs,cjs,json,md,yml,yaml}'",
    "format:check": "oxfmt --check '**/*.{ts,tsx,js,jsx,mts,cts,mjs,cjs,json,md,yml,yaml}'",
    "release": "semantic-release",
    "release:dryRun": "semantic-release --dry-run",
    "prepare": "is-ci || husky install"
  },
  "dependencies": {
    "colors": "1.4.0",
    "date-format": "^4.0.14",
    "globby": "^16.2.4",
    "lerna": "8.2.3",
    "nodemailer": "^9.1.1",
    "semver": "^7.8.5",
    "streamroller": "^3.1.5",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "@swc/core": "1.13.3",
    "@swc/helpers": "0.5.17",
    "@tsed/markdown-it-symbols": "3.20.9",
    "@tsed/monorepo-utils": "3.3.3",
    "@tsed/ts-doc": "5.0.0",
    "@types/node": "20.19.9",
    "@vitest/coverage-v8": "3.2.4",
    "barrelsby": "2.8.1",
    "concurrently": "^9.2.0",
    "coveralls": "^3.1.1",
    "cross-env": "10.0.0",
    "entities": "4.5.0",
    "gflow": "^5.1.4",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "lint-staged": "^16.1.4",
    "oxfmt": "0.59.0",
    "oxlint": "1.74.0",
    "semantic-release": "^24.2.7",
    "semantic-release-slack-bot": "^4.0.2",
    "typescript": "7.0.2",
    "unplugin-swc": "^1.5.5",
    "vite": "7.0.6",
    "vite-plugin-dts": "^4.5.4",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.2.4"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,jsx,mts,cts,mjs,cjs}": [
      "oxlint --fix --no-error-on-unmatched-pattern",
      "oxfmt"
    ],
    "**/*.{json,md,yml,yaml}": [
      "oxfmt"
    ]
  },
  "packageManager": "yarn@4.18.0",
  "monorepo": {
    "productionBranch": "production",
    "npmAccess": "public",
    "ghpages": [
      {
        "dir": "./docs/.vitepress/dist",
        "url": "https://github.com/tsedio/logger.tsed.dev.git",
        "branch": "gh-pages",
        "cname": "logger.tsed.dev"
      }
    ]
  }
}
